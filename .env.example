# ===========================================================================
# TEMPLATE KONFIGURASI (.env.example)
# Salin berkas ini menjadi .env lalu isi nilainya
# ===========================================================================

# Token Bot Telegram dari @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# ID Chat / Channel Telegram tujuan
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Google Gemini API Key (dapatkan di https://aistudio.google.com/)
API_AI=your_gemini_api_key_here

# Model Gemini
GEMINI_MODEL=gemini-2.5-flash

# Token Hugging Face (opsional jika deploy ke Space)
HF_TOKEN=your_huggingface_token_here

# ===========================================================================
# PENGATURAN SCRAPER IDX
# ===========================================================================

# URL Keterbukaan Informasi Bursa Efek Indonesia
IDX_URL=https://www.idx.co.id/id/perusahaan-tercatat/keterbukaan-informasi/

# Interval pengecekan (dalam menit)
POLL_INTERVAL=5

# Jumlah halaman pengumuman yang discan per putaran
PAGES_TO_SCAN=2

# Mode Browser Headless: false (Offscreen Chrome asli, aman dari Cloudflare)
HEADLESS=false

# Port Web Dashboard
PORT=7860
HOST=0.0.0.0
